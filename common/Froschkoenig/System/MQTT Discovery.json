// ==========================================================
// Homematic -> Home Assistant MQTT Discovery
// ioBroker Javascript Adapter
// Version 2.0 TOW / ChatGPT
// STATE                switch
// LEVEL                light
// TEMPERATURE          sensor
// ACTUAL_TEMPERATURE   sensor
// HUMIDITY             sensor
// LOWBAT               binary_sensor
// LOW_BAT              binary_sensor
// UNREACH              binary_sensor
// PRESS_SHORT          device_automation
// PRESS_LONG           device_automation
// ==========================================================

const mqttPrefix = "homeassistant";
const mqttInstance = "mqtt.0";
const statePrefix = "iobroker";

// ==========================================================
// MQTT Discovery senden
// ==========================================================

function publishDiscovery(id, type, config) {

    const topic = `${mqttPrefix}/${type}/${id}/config`;

    sendTo(mqttInstance, "sendMessage2Client", {
        topic: topic,
        message: JSON.stringify(config),
        qos: 0,
        retain: true
    });
}

// ==========================================================
// Helper
// ==========================================================

function sanitize(str) {

    return String(str)
        .replace(/\s+/g, "_")
        .replace(/[^\w]/g, "_")
        .replace(/_+/g, "_")
        .toLowerCase();
}

// ==========================================================
// Gerätenamen / Modell holen
// ==========================================================

function getDeviceInfo(adapterAddress, deviceAddress) {

    let deviceName = deviceAddress;
    let model = "Homematic";

    try {

        const deviceObj = getObject(`hm-rpc.${adapterAddress}.${deviceAddress}`);

        if (deviceObj && deviceObj.native) {

            // Type
            if (deviceObj.native.TYPE) {             
                model = deviceObj.native.TYPE;
            }

            // Gerätename
            deviceName = `${model}_${deviceAddress}`;
        }

    } catch (e) {

        log(`Fehler bei DeviceInfo ${deviceAddress}: ${e}`, "warn");
    }

    return {
        identifiers: [deviceAddress],
        name: deviceName,
        manufacturer: "Homematic",
        model: model
    };
}

// ==========================================================
// Schönen Entitätsnamen holen
// ==========================================================

function getEntityName(id, fallback) {

    try {

        const obj = getObject(id);

        if (obj && obj.common && obj.common.name) {

            if (typeof obj.common.name === "string") {
                return obj.common.name;
            }

            if (typeof obj.common.name === "object") {

                if (obj.common.name.de) {
                    return obj.common.name.de;
                }

                if (obj.common.name.en) {
                    return obj.common.name.en;
                }
            }
        }

    } catch (e) {}

    return fallback;
}

// ==========================================================
// Discovery erzeugen
// Beispiel: hm-rpc.0.0001D3C996150C.0.ACTUAL_TEMPERATURE
//           0     .1.2             .3.4
// ==========================================================

$('hm-rpc.*').each(function (id) {

    if (!existsObject(id)) return;

    const parts = id.split('.');

    if (parts.length < 5) return;

    const adapterAddress = parts[1];
    const deviceAddress = parts[2];
    const channel = parts[3];
    const state = parts[4];

    // Nur gewünschte States
    const allowedStates = [
        "STATE",
        "LEVEL",
        "TEMPERATURE",
        "ACTUAL_TEMPERATURE",
        "PRESS_SHORT",
        "PRESS_LONG",
        "HUMIDITY",
        "LOWBAT",
        "UNREACH"
    ];

    if (!allowedStates.includes(state)) return;

    const entityName =
        getEntityName(id, `${deviceAddress} ${state}`);

    const uniqueId =
        sanitize(id);

    const mqttStateTopic =
        `${statePrefix}/${id.replace(/\./g, "/")}`;

    const mqttCommandTopic =
        `command/${statePrefix}/${id.replace(/\./g, "/")}`;

    const deviceInfo =
        getDeviceInfo(adapterAddress, deviceAddress);

    // ======================================================
    // STATE
    // ======================================================

    if (state === "STATE") {

        publishDiscovery(
            uniqueId,
            "switch",
            {
                name: entityName,
                unique_id: uniqueId,

                state_topic: mqttStateTopic,
                command_topic: mqttCommandTopic,

                payload_on: "true",
                payload_off: "false",

                device: deviceInfo
            }
        );
    }

    // ======================================================
    // LEVEL (Dimmer)
    // ======================================================

    if (state === "LEVEL") {

        publishDiscovery(
            uniqueId,
            "light",
            {
                name: entityName,
                unique_id: uniqueId,

                state_topic: mqttStateTopic,
                command_topic: mqttCommandTopic,

                brightness: true,
                brightness_scale: 1,

                payload_on: "1",
                payload_off: "0",

                device: deviceInfo
            }
        );
    }

    // ======================================================
    // TEMPERATURE
    // ======================================================

    if (
        state === "TEMPERATURE" ||
        state === "ACTUAL_TEMPERATURE"
    ) {

        publishDiscovery(
            uniqueId,
            "sensor",
            {
                name: entityName,
                unique_id: uniqueId,

                state_topic: mqttStateTopic,

                unit_of_measurement: "°C",
                device_class: "temperature",
                state_class: "measurement",

                device: deviceInfo
            }
        );
    }

    // ======================================================
    // HUMIDITY
    // ======================================================

    if (state === "HUMIDITY") {

        publishDiscovery(
            uniqueId,
            "sensor",
            {
                name: entityName,
                unique_id: uniqueId,

                state_topic: mqttStateTopic,

                unit_of_measurement: "%",
                device_class: "humidity",
                state_class: "measurement",

                device: deviceInfo
            }
        );
    }

    // ======================================================
    // LOWBAT
    // ======================================================

    if (
        state === "LOWBAT" ||
        state === "LOW_BAT"
    ) {

        publishDiscovery(
            uniqueId,
            "binary_sensor",
            {
                name: entityName,
                unique_id: uniqueId,

                state_topic: mqttStateTopic,

                payload_on: "true",
                payload_off: "false",

                device_class: "battery",

                entity_category: "diagnostic",

                device: deviceInfo
            }
        );
    }

    // ======================================================
    // UNREACH
    // ======================================================

    if (state === "UNREACH") {

        publishDiscovery(
            uniqueId,
            "binary_sensor",
            {
                name: entityName,
                unique_id: uniqueId,

                state_topic: mqttStateTopic,

                payload_on: "true",
                payload_off: "false",

                device_class: "connectivity",

                entity_category: "diagnostic",

                device: deviceInfo
            }
        );
    }

    // ======================================================
    // PRESS_SHORT
    // ======================================================

    if (state === "PRESS_SHORT") {

        publishDiscovery(
            uniqueId,
            "device_automation",
            {
                automation_type: "trigger",

                topic: mqttStateTopic,

                type: "button_short_press",
                subtype: channel,

                payload: "true",

                device: deviceInfo,

                unique_id: uniqueId
            }
        );
    }

    // ======================================================
    // PRESS_LONG
    // ======================================================

    if (state === "PRESS_LONG") {

        publishDiscovery(
            uniqueId,
            "device_automation",
            {
                automation_type: "trigger",

                topic: mqttStateTopic,

                type: "button_long_press",
                subtype: channel,

                payload: "true",

                device: deviceInfo,

                unique_id: uniqueId
            }
        );
    }

});

// ==========================================================

log("Homematic MQTT Discovery vollständig erstellt", "info");